POSTGRES_HOST=postgres
POSTGRES_NAME=order_db
POSTGRES_USER=order_user
POSTGRES_PASSWORD=12345
POSTGRES_PORT=5432
POSTGRES_SSL=disable

CACHE_SIZE=100

HTTP_PORT=8081
